# ============================================================
#  NeuralOrbit Backend — Environment Variables
#  Copy this to .env and fill in your real values
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development

# Auth enforcement — set to false for local dev without JWT
AUTH_REQUIRED=false

# CORS origins (comma-separated)
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080

# ── Supabase ─────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
# SECURITY: these are placeholders. Never paste real values into this file —
# it is committed to git. Real values belong only in your local, gitignored .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# From: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── LLM (Phase 1 = mock, no key needed) ──────────────────────
LLM_PROVIDER=mock
# Options: mock | openai | gemini | claude
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# LLM_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-...

# ── Redis (for Celery — Phase 2) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
